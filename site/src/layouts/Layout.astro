---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A self-directed liberal education, one book at a time — 500 books over 10-20 years.' } = Astro.props;
const pageTitle = `${title} · 500 Books`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      // Runs before CSS paints, so there's no flash of the wrong theme.
      // Falls back to the OS preference on a first visit, then remembers
      // whatever the visitor picked via the toggle button below.
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="500 Books" href="/rss.xml" />
    <title>{pageTitle}</title>

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#8a3324" />

    <meta property="og:site_name" content="500 Books" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL('/android-chrome-512x512.png', Astro.site)} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:site" content="@5hundredbooks" />
    <meta name="twitter:image" content={new URL('/android-chrome-512x512.png', Astro.site)} />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="site-title" href="/">
          <img src="/logo.png" width="36" height="36" alt="" class="site-logo" />
          <span>
            The 500 Books Challenge
            <small>ABL — Always Be Learning</small>
          </span>
        </a>
        <nav class="site-nav">
          <a href="/about/">About</a>
          <a href="/categories/">Categories</a>
          <a href="/reading-order/">Reading Order</a>
          <a href="/reading-log/">Reading Log</a>
          <a href="/library/">My Library</a>
          <a href="/blog/">Blog</a>
          <a href="/rss.xml">RSS</a>
          <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch between light and dark mode">
            <span class="icon-light" aria-hidden="true">&#127769;</span>
            <span class="icon-dark" aria-hidden="true">&#9728;&#65039;</span>
          </button>
        </nav>
      </div>
    </header>
    <div class="wrap">
      <slot />
      <footer class="site-footer">
        <p>fivehundredbooks.com — a decade-plus, self-directed education. 125 novels, 375 non-fiction, 15 categories.</p>
        <div class="social-links">
          <a href="https://medium.com/@fivehundredbooks" rel="me">Medium</a>
          <a href="https://www.instagram.com/fivehundredbooks/" rel="me">Instagram</a>
          <a href="https://twitter.com/5hundredbooks" rel="me">X</a>
          <a href="https://glasp.co/#/fivehundredbooks" rel="me">Glasp</a>
          <a href="https://youtube.com/@5hundredbooks" rel="me">YouTube</a>
        </div>
      </footer>
    </div>
    <script is:inline>
      document.addEventListener('click', function (e) {
        var btn = e.target.closest('#theme-toggle');
        if (!btn) return;
        var current = document.documentElement.getAttribute('data-theme') || 'light';
        var next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>
