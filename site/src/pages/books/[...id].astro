---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { findByDataId, bySequence, categorySlug, getReadingStatus } from '../../lib/util';

export async function getStaticPaths() {
  const books = await getCollection('books');
  return books.map((b) => ({ params: { id: b.id }, props: { book: b, allBooks: books } }));
}

const { book, allBooks } = Astro.props;
const { data } = book;
const { Content } = await render(book);
const canonicalPath = new URL(Astro.url.pathname, Astro.site).toString();

// Category-adjacent (same category/mini-theme table order) -- useful as a
// secondary link, but NOT the actual reading order.
const catPrev = findByDataId(allBooks, data.connects_from);
const catNext = findByDataId(allBooks, data.connects_to);

// The real reading order: master sequence 1-500, crossing category lines.
// This is what "Next" should mean on a book page -- previously it followed
// connects_to (same-category order), so clicking "Next" repeatedly walked
// through all 25 books in one category before ever leaving it, defeating the
// whole point of the interleaved staircase.
const ordered = bySequence(allBooks);
const seqIndex = ordered.findIndex((b) => b.id === book.id);
const seqPrev = seqIndex > 0 ? ordered[seqIndex - 1] : null;
const seqNext = seqIndex >= 0 && seqIndex < ordered.length - 1 ? ordered[seqIndex + 1] : null;

const readingStatus = getReadingStatus(book);

// Minimal schema.org/Book structured data. Kept conservative -- only fields
// we actually have and are confident about (name, author, url, and a rating
// once a book is genuinely finished and rated). No invented ISBNs/publish
// dates, since we don't have reliable ones for most editions.
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: data.title,
  author: { '@type': 'Person', name: data.author },
  url: canonicalPath,
};
if (data.why_chosen) jsonLd.abstract = data.why_chosen;
if (readingStatus === 'finished' && data.review.rating != null) {
  jsonLd.review = {
    '@type': 'Review',
    reviewRating: { '@type': 'Rating', ratingValue: data.review.rating, bestRating: 10 },
    author: { '@type': 'Person', name: 'Jez' },
  };
}
---

<Layout title={data.title} description={data.why_chosen ?? undefined}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <p class="meta">
    <a href={`/categories/${book.id.split('/')[0]}/`}>&larr; {data.category}</a>
  </p>

  <h1>{data.title}</h1>
  {data.subtitle && <p class="meta">{data.subtitle}</p>}
  <p>by {data.author}</p>

  <p class="meta">
    {data.type === 'nonfiction' ? `Mini-theme ${data.mini_theme} · Level ${data.level}` : 'Novel'}
    {data.sequence && ` · #${data.sequence} of 500`}
    {data.owned && <span class="owned-badge">you own this</span>}
    {readingStatus === 'finished' && (
      <span class="status-badge status-finished">
        ✓ finished{data.review.finished_on ? ` ${data.review.finished_on}` : ''}
        {data.review.rating != null && ` · ${data.review.rating}/10`}
      </span>
    )}
    {readingStatus === 'reading' && (
      <span class="status-badge status-reading">
        currently reading{data.review.started_on ? ` since ${data.review.started_on}` : ''}
      </span>
    )}
  </p>

  {data.why_chosen && <p>{data.why_chosen}</p>}
  {data.placement_note && <p><em>Why here in the reading order: {data.placement_note}</em></p>}
  {data.review.key_takeaway && <p class="key-takeaway">{data.review.key_takeaway}</p>}

  {data.connects_to_nonfiction && data.connects_to_nonfiction.length > 0 && (
    <p class="meta">
      Connects to:{' '}
      {data.connects_to_nonfiction.map((cat, i) => {
        const slug = categorySlug(cat);
        return (
          <>
            {i > 0 && ', '}
            {slug ? <a href={`/categories/${slug}/`}>{cat}</a> : cat}
          </>
        );
      })}
      {data.connects_to_nonfiction_note && ` — ${data.connects_to_nonfiction_note}`}
    </p>
  )}

  {data.source_lists && data.source_lists.length > 0 && (
    <p class="meta">On {data.source_lists.length} of the 9 source lists: {data.source_lists.join(', ')}</p>
  )}

  <div class="review-body">
    <Content />
  </div>

  <div class="connects">
    {seqPrev && (
      <p>
        &larr; #{seqPrev.data.sequence} in the reading order:{' '}
        <a href={`/books/${seqPrev.id}/`}>{seqPrev.data.title}</a>
      </p>
    )}
    {seqNext && (
      <p>
        #{seqNext.data.sequence} next in the reading order:{' '}
        <a href={`/books/${seqNext.id}/`}>{seqNext.data.title}</a> &rarr;
      </p>
    )}
    {catPrev && (
      <p class="meta">
        Also in {data.category}, before this: <a href={`/books/${catPrev.id}/`}>{catPrev.data.title}</a>
      </p>
    )}
    {catNext && (
      <p class="meta">
        Also in {data.category}, after this: <a href={`/books/${catNext.id}/`}>{catNext.data.title}</a>
      </p>
    )}
  </div>
</Layout>
