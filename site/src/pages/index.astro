---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { bySequence, readingProgress, isCurrentlyReading } from '../lib/util';

const books = await getCollection('books');
const nonfiction = books.filter((b) => b.data.type === 'nonfiction');
const novels = books.filter((b) => b.data.type === 'fiction');
const categories = [...new Set(nonfiction.map((b) => b.data.category))];

const ordered = bySequence(books);
const firstBook = ordered[0];
const progress = readingProgress(books);
const pct = progress.total ? Math.round((progress.finishedCount / progress.total) * 100) : 0;

// Full "Currently Reading" cards live in their own section below rather than
// the one-line progress-detail mention, so there isn't a redundant second
// "currently reading: X" right underneath it. Sorted newest-started-first so
// a second book picked up later shows above one already underway.
const currentlyReading = books
  .filter(isCurrentlyReading)
  .sort((a, b) => (b.data.review.started_on ?? '').localeCompare(a.data.review.started_on ?? ''));
---

<Layout title="Home">
  <h1>The 500 Books Challenge</h1>
  <p class="meta">A self-directed liberal education, 10–20 years, one book at a time.</p>

  <p>
    A university education costs tens of thousands. The greatest books ever written cost
    a library card. This is an attempt to build that education anyway — deliberately, in
    order, one book at a time. Not a reading sprint or a Goodreads challenge: an attempt to
    build the education I wish I'd had — why civilizations rise and fall, how governments
    and economies work, how science explains reality, what philosophers have argued for
    2,500 years, and the greatest stories ever written, all connected rather than studied
    in isolation.
  </p>

  <p>
    <strong>{nonfiction.length}</strong> non-fiction books across{' '}
    <strong>{categories.length}</strong> categories, plus{' '}
    <strong>{novels.length}</strong> novels, sequenced into a single staircase —
    each book preparing the reader for the next.
  </p>

  <div class="progress-module">
    <div class="progress-stat">
      <span class="progress-count">{progress.finishedCount} of {progress.total}</span>
      <span class="progress-label">read</span>
    </div>
    <div class="progress-track"><div class="progress-fill" style={`width:${pct}%`}></div></div>
    {(progress.lastFinished || !progress.currentlyReading) && (
      <p class="progress-detail">
        {progress.lastFinished && (
          <span>Last finished: <a href={`/books/${progress.lastFinished.id}/`}>{progress.lastFinished.data.title}</a>. </span>
        )}
        {!progress.currentlyReading && !progress.lastFinished && (
          <span>The journey hasn't started yet — book #1 is below.</span>
        )}
      </p>
    )}
  </div>

  <section class="currently-reading">
    <h2>Currently Reading</h2>
    {currentlyReading.length > 0 ? (
      <div class="cr-grid">
        {currentlyReading.map((b) => (
          <article class={`cr-card${b.data.image ? '' : ' no-cover'}`}>
            {b.data.image && (
              <a href={`/books/${b.id}/`} class="cr-cover-link">
                <img src={b.data.image} alt={`Cover of ${b.data.title}`} class="cr-cover" loading="lazy" />
              </a>
            )}
            <div class="cr-body">
              <p class="meta">
                {b.data.category}
                {b.data.review.started_on && ` · started ${b.data.review.started_on}`}
              </p>
              <h3><a href={`/books/${b.id}/`}>{b.data.title}</a></h3>
              <p class="cr-author">by {b.data.author}</p>
              {b.data.about && <p class="cr-about">{b.data.about}</p>}
              {b.data.tags && b.data.tags.length > 0 && (
                <p class="cr-tags">
                  {b.data.tags.map((t) => <span class="cr-tag">{t}</span>)}
                </p>
              )}
              <p class="cr-links">
                <a href={`/books/${b.id}/`}>Book page &rarr;</a>
                {b.data.goodreads_url && (
                  <a href={b.data.goodreads_url} rel="noopener nofollow" target="_blank">Goodreads &rarr;</a>
                )}
              </p>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="log-empty">Nothing in progress right now.</p>
    )}
  </section>

  {firstBook && (
    <a class="cta-primary" href={`/books/${firstBook.id}/`}>
      {progress.finishedCount > 0 || progress.currentlyReading ? 'Continue Your 500 Books Journey' : 'Begin Your 500 Books Journey'} &rarr;
    </a>
  )}

  <p class="start-links">
    <a href="/categories/">Browse the 15 categories + novels</a> ·{' '}
    <a href="/reading-order/">See the full 500-book reading order</a> ·{' '}
    <a href="/blog/">Read the blog</a>
  </p>
</Layout>
